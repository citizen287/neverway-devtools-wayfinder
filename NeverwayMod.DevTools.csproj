<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.*" />
    <PackageReference Include="ImGui.NET" Version="1.91.*" />
  </ItemGroup>

  <PropertyGroup>
    <GameAssemblyPath Condition="'$(GameAssemblyPath)' == ''">..\..\lib</GameAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Murder">
      <HintPath>/gay/neverway/nw-again/Murder.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bang">
      <HintPath>/gay/neverway/nw-again/Bang.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FNA">
      <HintPath>/gay/neverway/nw-again/FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Neverway">
      <HintPath>/gay/neverway/nw-again/Neverway.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="UI\entities.json" />
  </ItemGroup>
</Project>
